# MarineSABRES Demonstration Area Tool - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# Flask Configuration
FLASK_ENV=production  # Options: development, production, testing
FLASK_HOST=127.0.0.1  # Use 127.0.0.1 for production (nginx reverse proxy), 0.0.0.0 for development
FLASK_RUN_PORT=5002  # Port for Gunicorn to bind to
FLASK_DEBUG=0  # MUST be 0 in production

# Security (REQUIRED for production)
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# This will be auto-generated during deployment if not set
SECRET_KEY=your-secret-key-here

# Application Settings
APPLICATION_ROOT=/DA  # Subpath for deployment (e.g., /DA for http://laguna.ku.lt/DA/)

# WMS Service Configuration - EMODnet Seabed Habitats
WMS_BASE_URL=https://ows.emodnet-seabedhabitats.eu/geoserver/emodnet_view/wms
WMS_VERSION=1.3.0
WMS_TIMEOUT=30  # Increased timeout for WMS GetCapabilities requests

# Human Activities WMS Service Configuration
HUMAN_ACTIVITIES_WMS_BASE_URL=https://ows.emodnet-humanactivities.eu/wms

# Map Display Settings
MAX_LAYERS_DISPLAY=20
DEFAULT_MAP_CENTER_LAT=42.0  # Centered on Mediterranean for Tuscan Archipelago
DEFAULT_MAP_CENTER_LNG=10.0
DEFAULT_MAP_ZOOM=6

# Caching Settings
# Options: simple (in-memory), redis, filesystem
CACHE_TYPE=simple  # Use 'redis' for distributed caching in multi-worker setup
CACHE_DEFAULT_TIMEOUT=3600  # 1 hour in seconds
WMS_CACHE_TIMEOUT=300  # 5 minutes in seconds

# Redis Cache Configuration (only used if CACHE_TYPE=redis)
# Required for distributed caching across multiple Gunicorn workers
#CACHE_REDIS_URL=redis://:password@localhost:6379/0
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
#CACHE_REDIS_PASSWORD=your-redis-password-here

# Filesystem Cache Configuration (only used if CACHE_TYPE=filesystem)
CACHE_DIR=cache
CACHE_THRESHOLD=1000  # Maximum number of items in cache

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Performance Settings
MAX_WORKERS=auto  # Auto-scales based on CPU cores (2 * cores + 1)
WORKER_TIMEOUT=120  # Gunicorn worker timeout in seconds

# Research Sites Configuration
# Tuscan Archipelago (Isola d'Elba, Mediterranean)
SITE_TUSCAN_LAT=42.8
SITE_TUSCAN_LNG=10.3
SITE_TUSCAN_ZOOM=10

# Arctic Northeast Atlantic
SITE_ARCTIC_LAT=70.0
SITE_ARCTIC_LNG=20.0
SITE_ARCTIC_ZOOM=6

# Macaronesia (Azores)
SITE_MACARONESIA_LAT=38.5
SITE_MACARONESIA_LNG=-28.0
SITE_MACARONESIA_ZOOM=8
